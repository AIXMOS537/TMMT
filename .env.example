# Copy to .env and fill in values. Never commit .env.

# Supabase (required for build and runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domain routing (Vercel production)
NEXT_PUBLIC_PUBLIC_SITE_HOST=allinonemanagementsolutions.com
NEXT_PUBLIC_OWNER_HUB_HOST=allinonemanagementsolutions.net

# GoHighLevel — checkout and ops links (optional until live)
NEXT_PUBLIC_GHL_CHECKOUT_97=
NEXT_PUBLIC_GHL_CHECKOUT_LLC=
NEXT_PUBLIC_GHL_CHECKOUT_3750=
NEXT_PUBLIC_GHL_OPERATOR_APPLY=
NEXT_PUBLIC_GHL_FORM_EMBED=
NEXT_PUBLIC_GHL_UPSELL_PIPELINE_URL=https://app.gohighlevel.com/
NEXT_PUBLIC_GHL_WEBHOOK_SECRET=

# GHL webhook → Supabase (server only)
GHL_WEBHOOK_SECRET=

# Airtable (npm run sync:aixmos-people)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_BASE_NAME=AIXMOS Operations
AIRTABLE_PEOPLE_TABLE=People

# AI command desk (optional)
ANTHROPIC_API_KEY=

# AIXMOS cube — one deployment (aixmos.com/learn + /work)
NEXT_PUBLIC_CUBE_SAME_ORIGIN=true
NEXT_PUBLIC_CUBE_PERSISTENCE=supabase
NEXT_PUBLIC_AIXMOS_SITE_URL=https://aixmos.com
NEXT_PUBLIC_AIXMOS_LEARN_BASE_URL=https://aixmos.com/learn
# Local split-face dev (optional)
NEXT_PUBLIC_CUBE_LEARN_URL=http://localhost:3001
NEXT_PUBLIC_CUBE_WORK_URL=http://localhost:3000
NEXT_PUBLIC_ENGINE_URL=http://localhost:3001
NEXT_PUBLIC_WORKFORCE_URL=http://localhost:3000
# GHL program webhook: POST /api/webhooks/ghl/program (tag: ready-for-aixmos)
