# Copy to .env and fill in values. Never commit .env.

# Supabase (required for build and runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Command Center bridge (optional) — read-only cross-project link to the root TMMT
# Command Center Supabase (contracts, background_checks). See src/lib/command-center-bridge/client.ts.
COMMAND_CENTER_SUPABASE_URL=
COMMAND_CENTER_SUPABASE_SERVICE_KEY=

# Mixpanel product analytics (client-side)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Domain routing (Vercel production — staff-only .net on Vercel; .com marketing on GHL)
NEXT_PUBLIC_OWNER_HUB_HOST=tmmtrentals.net

# GoHighLevel — checkout and ops links (required for revenue pipeline)
# Kit sales (USB + online) — see docs/SALES-CHANNELS.md
NEXT_PUBLIC_GHL_CHECKOUT_OPS_KIT=
NEXT_PUBLIC_GHL_CHECKOUT_OPS_KIT_USB=
NEXT_PUBLIC_GHL_CHECKOUT_COMMAND_KIT=
NEXT_PUBLIC_GHL_CHECKOUT_COMMAND_KIT_USB=
NEXT_PUBLIC_GHL_CHECKOUT_DEALER_BUNDLE=
NEXT_PUBLIC_GHL_CHECKOUT_97=
NEXT_PUBLIC_GHL_CHECKOUT_LLC=
NEXT_PUBLIC_GHL_CHECKOUT_3750=
# High-ticket build DEPOSIT checkouts (powers /build — see docs/HIGH-TICKET-GO-LIVE.md)
NEXT_PUBLIC_GHL_CHECKOUT_7500=
NEXT_PUBLIC_GHL_CHECKOUT_15000=
NEXT_PUBLIC_GHL_CHECKOUT_25000=
# Book-a-strategy-call link (top tier + universal CTA fallback)
NEXT_PUBLIC_GHL_CONSULT_CALL=
# Support contact shown on /kits and /build (optional)
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_GHL_OPERATOR_APPLY=
NEXT_PUBLIC_GHL_CREDIT_GUIDANCE=
NEXT_PUBLIC_GHL_UPSELL_PIPELINE_URL=

# GHL webhook → Supabase (server only)
GHL_WEBHOOK_SECRET=
GHL_VOICE_WEBHOOK_SECRET=

# Local Ollama endpoint — read by scripts/hailmary-*.sh only, not by the app.
OLLAMA_URL=http://127.0.0.1:11434
# Retired 2026-09-08 (nothing in the repo reads them): CREDIT_ENGINE_SECRET,
# CREDIT_ENGINE_INFERENCE, CREDIT_ENGINE_AUTO_POLISH, OLLAMA_CREDIT_MODEL,
# NVIDIA_NIM_BASE_URL, NVIDIA_NIM_MODEL, NVIDIA_API_KEY, NEXT_PUBLIC_GHL_FORM_EMBED.

# ClickUp — case + GHL event → task creation
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=90132245195
CLICKUP_LIST_FLEET=901318986996
CLICKUP_LIST_OPS=901318985770
CLICKUP_LIST_OPS_GENERAL=901318987056
CLICKUP_LIST_REPO=901318985964
CLICKUP_LIST_TICKETS=901318986343
NEXT_PUBLIC_CLICKUP_WORKSPACE_URL=https://app.clickup.com/90132245195

# Airtable (npm run sync:aixmos-people)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_BASE_NAME=AIXMOS Operations
AIRTABLE_PEOPLE_TABLE=People

# AI command desk (optional)
ANTHROPIC_API_KEY=

# AIXMOS cube — one deployment (aixmos.com/learn + /work)
NEXT_PUBLIC_CUBE_SAME_ORIGIN=true
NEXT_PUBLIC_CUBE_PERSISTENCE=supabase
NEXT_PUBLIC_AIXMOS_SITE_URL=https://aixmos.com
NEXT_PUBLIC_AIXMOS_LEARN_BASE_URL=https://aixmos.com/learn
# Local split-face dev (optional)
NEXT_PUBLIC_CUBE_LEARN_URL=http://localhost:3001
NEXT_PUBLIC_CUBE_WORK_URL=http://localhost:3000
NEXT_PUBLIC_ENGINE_URL=http://localhost:3001
NEXT_PUBLIC_WORKFORCE_URL=http://localhost:3000
# GHL program webhook: POST /api/webhooks/ghl/program (tag: ready-for-aixmos)

# ─── Rescue Dispatch (Subproject #1) ───
# Map + geocoding: uses Leaflet + OpenStreetMap Nominatim. No API keys required.
# AIXMOS agent host for CAPTAIN refinement (optional; fail-open on timeout).
AIXMOS_AGENT_HOST=http://127.0.0.1:7777
# Telegram bot used for dispatch responder pings AND Phase 9 credit-funding handoff notifications.
# Owner chat ID is the fallback for dispatch, and the primary target for handoff pings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Rescue Dispatch RLS isolation smoke test (Playwright)
E2E_TMMT_EMAIL=
E2E_TMMT_PASSWORD=
E2E_PILOT_EMAIL=
E2E_PILOT_PASSWORD=

# ─── Phase 9 handoff notifications (optional) ───
# Fired only when a credit-funding intake submits with operator_handoff_requested=true.
# Leave any var blank to skip that channel — the form still succeeds either way.
#
# Slack: create an incoming webhook in your workspace (https://api.slack.com/messaging/webhooks)
#        and point it at the channel you want pinged (e.g. #sales).
SLACK_WEBHOOK_URL=
#
# iMessage: the relay at 100.77.126.8:8787 is Tailscale-only. To reach it from Vercel,
#           expose it via Cloudflare Tunnel / ngrok and set the public URL here.
#           Expected protocol: POST JSON { to, text }; bearer token optional.
IMESSAGE_RELAY_URL=
IMESSAGE_NOTIFY_TO=
IMESSAGE_RELAY_TOKEN=

# ─── Money Meter (optional) ───
# The unified money meter (src/lib/money-meter.ts, /money dashboard) tracks every
# dollar USED, SAVED, and COLLECTED across the platform.
#
# Owner + family are FREE FOREVER: their usage is recorded (so you see what it
# would cost) but never billed. The owner's home org is seeded free-forever in
# migration 20260718000000; add family/personal emails here (comma-separated).
# The owner's email is always free even if this is blank.
MONEY_METER_FREE_FOREVER_EMAILS=
#
# What one Pocket coach job would have cost on a cloud model. We serve it on the
# owner's local brain instead, so the meter books this as money SAVED. Default 0.02.
POCKET_CLOUD_EQUIV_USD=

# ─── GHL integration secrets (referenced in code, previously undocumented here) ───
GHL_API_KEY=
GHL_OVERDUE_WEBHOOK_SECRET=
# Feature/behavior flags for the GHL sync paths — see src/lib/ghl for usage.
GHL_AUTO_OPS=
GHL_CLIENT_ALERTS=
GHL_FORM_AUTO_CASE=
GHL_CASE_STATUS_MAP_JSON=
GHL_PIPELINE_STAGE_MAP_JSON=
GHL_STAGE_OPS_JSON=

# ─── Ops/admin/audit surface secrets (referenced in code, previously undocumented here) ───
ADMIN_KEY=
AUDIT_INGEST_KEY=
AIXMOS_AGENT_TOKEN=
OPS_COMMAND_SECRET=
SYNC_WEBHOOK_SECRET=
POCKET_BRAIN_KEY=
# Kill switch for automated ops flows — set to disable without a redeploy.
B3_KILL_SWITCH=

# ─── Third-party API keys used elsewhere in src/ (previously undocumented here) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AIRTABLE_API_KEY=
OPENAI_API_KEY=

# ─── Added 2026-09-08 (remediation F-24): every name below is read by src/, shared/ or packages/ ───
# src/lib/env-example.test.ts fails the build if the app reads a name this file does not list.
# Platform-supplied and never set by hand: NODE_ENV, NEXT_RUNTIME, VERCEL_URL.

# Supabase — server-side fallback URL when NEXT_PUBLIC_SUPABASE_URL is unset (src/lib/agent/supabase-server.ts)
SUPABASE_URL=

# Cron + scheduled jobs — bearer / x-cron-secret for /api/cron/* and /api/mission/generate
# (falls back to OPS_COMMAND_SECRET when unset). Set in Vercel and in .github/workflows/mission-daily.yml.
CRON_SECRET=
# Name used in the daily mission greeting (default "Owner")
MISSION_GREETING_NAME=

# GHL — locations and sub-accounts (src/lib/ghl/client.ts)
GHL_LOCATION_ID=
GHL_RESTORATION_LOCATION_ID=
# GHL Conversations: provider id for SMS sends and the From address for email
GHL_CONVERSATION_PROVIDER_ID=
GHL_EMAIL_FROM=
# GHL custom-field KEYS the portal writes back to a contact (src/lib/ghl/sync-contact-portal-fields.ts).
# Defaults: tmmt_case_ref, tmmt_track_url, tmmt_portal_url, tmmt_portal_login_url.
GHL_CF_CASE_REF_KEY=
GHL_CF_TRACK_URL_KEY=
GHL_CF_PORTAL_URL_KEY=
GHL_CF_LOGIN_URL_KEY=
# Marketing KPI cron: comma-separated tag / appointment-title patterns (src/lib/marketing-kpi/ghl-sync.ts)
GHL_KPI_SUBSCRIBER_TAG_PATTERNS=
GHL_KPI_STRATEGY_APPOINTMENT_PATTERNS=
# Default assignee for ops-command created work (src/lib/ops-command/stage-rules.ts)
GHL_DEFAULT_ASSIGNEE_EMAIL=
TMMT_OPS_DEFAULT_ASSIGNEE=
# Monthly checkout links on /kits (siblings of the one-time links above; src/lib/kit-checkout.ts)
NEXT_PUBLIC_GHL_CHECKOUT_OPS_MONTHLY=
NEXT_PUBLIC_GHL_CHECKOUT_COMMAND_MONTHLY=
NEXT_PUBLIC_GHL_CHECKOUT_DEALER_MONTHLY=

# Airtable webhook table names (src/app/api/webhooks/airtable/route.ts). Defaults: "Leads", "Ops Locations".
AIRTABLE_LEADS_TABLE=
AIRTABLE_OPS_LOCATIONS_TABLE=

# ClickUp list used by ops-command when no routing rule matches (src/lib/ops-command/execute.ts)
CLICKUP_DEFAULT_LIST_ID=

# Ops AI review model (src/lib/ops-ai.ts). Default claude-sonnet-4-20250514.
ANTHROPIC_OPS_MODEL=

# Pocket coach brain — OpenAI-compatible endpoint on the owner's box (src/lib/pocket-brain.ts).
# Unset = coach replies 503 before spending a token. POCKET_BRAIN_KEY is listed above.
POCKET_BRAIN_URL=
POCKET_BRAIN_MODEL=
POCKET_BRAIN_TIMEOUT_MS=
POCKET_BRAIN_MAX_TOKENS=
# Token economics (src/lib/token-ledger.ts, src/lib/referrals.ts): tokens per job, tokens granted per
# member-97 payment, referral commission rate. Defaults live in code; leave blank to use them.
POCKET_COST_PER_JOB=
MEMBER_97_MONTHLY_TOKENS=
POCKET_REFERRAL_RATE=

# Public URLs the app needs to know about itself
# Canonical site origin for links in emails/documents (src/app/(admin)/document-actions.ts)
NEXT_PUBLIC_SITE_URL=
# Origin used in the GHL voice-agent status payload (src/app/api/agent/voice/ghl/route.ts)
NEXT_PUBLIC_APP_URL=
# Partner app URL returned to a freshly provisioned installation (src/app/api/license/provision/route.ts)
PARTNER_APP_URL=
# Affiliate application link on /forms/affiliates (default: /forms/apply?ref=affiliate)
NEXT_PUBLIC_AFFILIATE_APPLY_URL=
# Cube split-face URLs (packages/aixmos-core/src/cube/config.ts); default to <work>/command and <work>/fleet
NEXT_PUBLIC_CUBE_COMMAND_URL=
NEXT_PUBLIC_CUBE_FLEET_URL=
# Show the cube's demo role-switcher (=1). Off in every production build regardless of this flag's absence.
NEXT_PUBLIC_CUBE_DEMO_CONTROLS=

# Sentry — client, server and edge init read the same DSN (enabled only when NODE_ENV=production)
NEXT_PUBLIC_SENTRY_DSN=
