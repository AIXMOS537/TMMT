# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.legacy.example

# vercel
.vercel

# dealer handoff packs (generated by provision-dealer-instance.mjs)
/handoffs/

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/

# AIXMOS portal logins (generated from Airtable — never commit)
AIXMOS/portal/data/users.json

# superpowers brainstorm session files
.superpowers/

# Personal Claude memory / overrides (not shared)
.claude.local.md
.claude/settings.local.json

# Business docs (canonical in ~/Documents/Business/)
OPERATIONS_BRAIN.md
OPERATIONS_BRAIN.pdf
SKILLS_BRIEF.md
BrainKit/
deploy_brainkit_to_usb.sh

# Phase 9 notify secrets (local only)
scripts/phase9-notify/.env.notify

# Swarm: per-laptop identity + per-worktree agent prompt (local only)
.swarm/
.swarm-task.txt

# HAILMARY: local runtime state + absorbed memory snapshots (owner-local only)
.hailmary/
config/hailmary-brother.local.yaml
config/dual-sync.registry.local.yaml
config/voice-cards/*.local.yaml

# MEMORIAL: private, sacred, owner-local only — never pushed, never shared
.memorial/

# Python bytecode cruft
__pycache__/
*.pyc

.hailmary-backups/

# AIXMOS Ultimatrix: local PII denylist (owner-local only — NEVER commit PII)
.aixmos/pii_denylist.local
.aixmos/face/
*.bak-*

# AIXMOS runtime artifacts — per-machine, regenerated locally (heartbeat, device
# integrity scans, secret-scan reports, operator onboarding profiles). Never commit.
.aixmos/operators/
.aixmos/heartbeat/
.aixmos/integrity-*.txt
.aixmos/secret-scan-report.txt

# Sweep-archive dumps (one-time machine sweeps) — never commit; route real intake
# files to imports/<area>/ instead. (See docs/security/HISTORY-SCRUB-RUNBOOK.md)
imports/**/_SWEEP_ARCHIVE_*/
.env
*.local
node_modules/
dist/
# never commit secrets, bonds, registration numbers, client PII
secrets/
*.pii

# aider scratch (local only)
.aider*
.claude/worktrees/
