#!/bin/bash
# =============================================================================
# DRAFT — DO NOT RUN AS-IS (2026-06-09 review)
# =============================================================================
# This script was written assuming Mission Control = "cron-driven AI mission
# generation + Telegram push." Reality (verified 2026-06-09):
#
#   SHIPPED in canonical via PR #11 (commit 65476b6):
#     - src/components/mission/mission-board.tsx     (panel UI)
#     - src/lib/mission/build.ts                     (builder, sync)
#     - src/lib/mission/types.ts
#     - src/lib/mission/build.test.ts                (Vitest)
#
#   NEVER BUILT in canonical (what this script targets):
#     - /api/mission/generate                        (the POST endpoint)
#     - mission cron in vercel.json                  (would be 3rd cron — Hobby
#                                                     plan currently uses 2/2:
#                                                     marketing-kpi-ghl + journey-recompute;
#                                                     a 3rd risks quota)
#     - supabase/migrations/0008_mission_control.sql (does NOT exist locally)
#     - Telegram daily-push wiring                   (notify-telegram.ts exists
#                                                     but no per-teammate chat_id
#                                                     capture flow)
#
# WHY this matters: if you run this script today, the build is a no-op
# (nothing new to commit), the deploy redeploys current production, and the
# smoke test `POST /api/mission/generate` 404s. Harmless but useless.
#
# WHEN to revive this script: only after the four "NEVER BUILT" items above
# are implemented as a separate Spec. At that point:
#   1. Confirm Vercel plan is Pro (not Hobby) OR replace one of the existing
#      crons before adding a 3rd
#   2. Apply the 0008 migration to prod via supabase MCP (always list_migrations
#      FIRST — see memory project_supabase_migration_drift.md)
#   3. THEN this script becomes useful as the deploy harness
#
# Original script kept verbatim below for that future moment.
# REPO_DIR corrected from ~/AIXMOS537/TMMT → ~/Projects/TMMT (the actual
# canonical clone path on this Mac per memory project_tmmt_repo_layout.md).
# =============================================================================
set -euo pipefail

# ===== EDIT IF YOUR CHECKOUT IS ELSEWHERE =====
REPO_DIR="${REPO_DIR:-$HOME/Projects/TMMT}"
REPO_URL="https://github.com/AIXMOS537/TMMT.git"
BRANCH="master"
# ==============================================

say(){ printf "\n\033[1;36m▶ %s\033[0m\n" "$1"; }
ok(){  printf "  \033[1;32m✓ %s\033[0m\n" "$1"; }
warn(){ printf "  \033[1;33m! %s\033[0m\n" "$1"; }
die(){ printf "\n\033[1;31m✗ %s\033[0m\n" "$1"; exit 1; }

say "TMMT OS deploy — preflight (no changes yet)"
command -v git  >/dev/null || die "git missing. Run:  xcode-select --install"
command -v node >/dev/null || die "node missing. Install Node 18+ (brew install node)."
command -v npm  >/dev/null || die "npm missing."
ok "git $(git --version | awk '{print $3}') · node $(node -v) · npm v$(npm -v)"

if [ ! -d "$REPO_DIR/.git" ]; then
  warn "No repo at: $REPO_DIR"
  read -p "  Clone $REPO_URL there now? [y/N] " a
  [ "${a:-N}" = "y" ] || die "Edit REPO_DIR at the top of this script to your existing checkout, then re-run."
  mkdir -p "$(dirname "$REPO_DIR")"
  git clone "$REPO_URL" "$REPO_DIR" || die "Clone failed — GitHub auth. Run:  gh auth login  (or add a PAT) then re-run."
fi
cd "$REPO_DIR"
ok "repo: $REPO_DIR"

say "Testing GitHub access from THIS Mac"
git remote -v | grep -q "AIXMOS537/TMMT" || warn "remote isn't AIXMOS537/TMMT — check 'git remote -v'"
git ls-remote "$REPO_URL" >/dev/null 2>&1 || die "No repo access (auth). Fix:  gh auth login  then re-run."
ok "GitHub auth works here"

say "Checking the Mission Control code is present"
# NOTE 2026-06-09: this checks the WRONG path. The shipped panel lives at
# src/components/mission/mission-board.tsx, not src/lib/mission/board.ts.
# When this script is revived, also add a check for src/app/api/mission/generate/route.ts
# which is the actual deploy gate.
if [ ! -f "src/lib/mission/board.ts" ]; then
  warn "Mission Control files are missing from this checkout."
  warn "First copy TMMT-MissionControl-code-COMPLETE.zip -> tmmt-os-changes/ into this repo (preserve paths),"
  warn "then re-run this script."
  die "Stopping so a half-built app never ships."
fi
ok "Mission Control files present"

say "Install + verify"
npm install
npm run typecheck
npm run build
ok "Build is green"

say "Vercel env vars (paste each value from Dashlane when prompted — nothing stored in this file)"
if command -v vercel >/dev/null; then
  for V in MISSION_WEBHOOK_SECRET CRON_SECRET TELEGRAM_BOT_TOKEN; do
    if vercel env ls production 2>/dev/null | grep -q "$V"; then
      ok "$V already set"
    else
      read -p "  Add $V now? [y/N] " a
      if [ "${a:-N}" = "y" ]; then vercel env add "$V" production; else warn "skipped $V — set later in Vercel dashboard"; fi
    fi
  done
else
  warn "Vercel CLI not installed (npm i -g vercel)."
  warn "Set these 3 in Vercel dashboard -> project 'tmmt-ops' -> Settings -> Environment Variables (from Dashlane):"
  warn "  MISSION_WEBHOOK_SECRET · CRON_SECRET · TELEGRAM_BOT_TOKEN"
fi

say "Ready to ship"
git add -A
if git diff --cached --quiet; then warn "Nothing new to commit (will still push current state)."; else
  git commit -m "Deploy: Mission Control (daily AI missions + Telegram push)"
fi
echo
read -p "  Push to '$BRANCH' and trigger the LIVE Vercel deploy? [y/N] " a
[ "${a:-N}" = "y" ] || die "Stopped before push. NOTHING was deployed."
git push origin "$BRANCH"
ok "Pushed — Vercel is building 'tmmt-ops' now. Watch: https://vercel.com/dashboard"

say "After it goes green"
echo "  • DB migration 0008_mission_control.sql is ALREADY applied — do not re-run it."
echo "  • Each teammate taps Start on the Telegram bot once -> capture their telegram_chat_id."
echo "  • Smoke test:  POST /api/mission/generate  header X-Mission-Secret  body {\"notify\":true}"
ok "Done."
