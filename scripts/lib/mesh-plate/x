#!/usr/bin/env bash
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
case "${1:-}" in
  --money|money) shift; exec bash "$ROOT/scripts/deal.sh" summary 2>/dev/null || echo "x --money: wire GHL checkout links" ;;
  fleet|fleet-up) exec bash "$ROOT/scripts/fleet-up.sh" "${@:2}" ;;
  handoff) shift; exec bash "$ROOT/scripts/mesh-handoff.sh" "$@" ;;
  m1|rick) exec bash "$ROOT/scripts/m1-door.sh" "${@:2}" ;;
  brain|brainiac) exec bash "$ROOT/scripts/mesh/brainiac-ctl.sh" "${@:2}" ;;
  "") exec bash "$ROOT/scripts/serve.sh" owner ;;
  *) exec bash "$ROOT/scripts/serve.sh" "$@" ;;
esac
