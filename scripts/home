#!/usr/bin/env bash
# home — open AIXMOS Mission Control (the holographic launcher) fullscreen.
#   bash scripts/home        (or, once aliased: home)
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FILE="$ROOT/tools/launcher/index.html"
[ -f "$FILE" ] || { echo "✗ launcher missing: $FILE"; exit 1; }
url="file://$FILE"
echo "◆ AIXMOS Mission Control → $FILE"
if command -v open >/dev/null 2>&1; then
  open -na "Google Chrome"  --args --app="$url" 2>/dev/null && exit 0
  open -na "Microsoft Edge" --args --app="$url" 2>/dev/null && exit 0
  open -na "Brave Browser"  --args --app="$url" 2>/dev/null && exit 0
  open "$url"; exit 0
fi
command -v xdg-open >/dev/null 2>&1 && { xdg-open "$FILE"; exit 0; }
command -v start    >/dev/null 2>&1 && { start "" "$FILE"; exit 0; }
echo "Open in a browser: $FILE"
