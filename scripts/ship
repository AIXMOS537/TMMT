#!/usr/bin/env bash
# ship — the ONE blessed path to production. Nothing reaches a live site any
# other way: Vercel git auto-deploy is OFF on every project (disconnected
# 2026-06-18), so a push can never deploy. Deploys are deliberate, owner-gated,
# and verified-first.
#
# THE LAW (per the owner, 2026-06-18 — "Project X HAILMARY"):
#   Build locally  ->  the owner verifies & ACCEPTS  ->  then, and only then, ship.
#
#   bash scripts/ship                 # build + verify + confirm + deploy tmmt-ops
#   bash scripts/ship tmmt-ops        # explicit project
#   bash scripts/ship aixmos-landing  # other apps: tmmt-command-center | aixmos-landing | aixmos-offer
#   bash scripts/ship --dry-run       # do everything EXCEPT the deploy (safe to run anytime)
#
# Gates, in order:
#   0) Kill-switch check
#   0.5) Upload firewall (.vercelignore) + forbidden-file scan
#   1) Owner Seal (auth/OWNER.seal) — the owner's passphrase. No seal, no ship.
#   2) Local production build (npm run build) — never spend a deploy on broken code.
#   3) Explicit typed confirmation: DEPLOY
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"; cd "$ROOT"

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
info() { printf '  \033[36m›\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '  \033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
hr()   { printf '\033[2m%s\033[0m\n' "────────────────────────────────────────────────────────"; }

_vercel_ignored() {
  local rel="$1" pat
  [ -f "$ROOT/.vercelignore" ] || return 1
  while IFS= read -r pat; do
    pat="${pat%%#*}"; pat="${pat%"${pat##*[![:space:]]}"}"
    [ -z "$pat" ] && continue
    case "$pat" in !*) continue ;; esac
    pat="${pat%/}"
    case "$rel" in
      "$pat"|"$pat"/*) return 0 ;;
    esac
    case "$pat" in
      *.*|*\*) case "$rel" in $pat) return 0 ;; esac ;;
    esac
  done < "$ROOT/.vercelignore"
  return 1
}

ship_upload_firewall() {
  info "Upload firewall — scanning for leaks before deploy…"
  [ -f "$ROOT/.vercelignore" ] || die "Missing .vercelignore — refuse to deploy. Vercel CLI uploads gitignored files."

  local req
  for req in .aixmos/ auth/ config/ docs/ scripts/; do
    grep -qF "$req" "$ROOT/.vercelignore" 2>/dev/null || \
      die ".vercelignore must exclude $req (confidential / local-only)."
  done
  ok ".vercelignore covers critical paths."

  local big rel
  while IFS= read -r big; do
    [ -n "$big" ] || continue
    rel="${big#$ROOT/}"
    if ! _vercel_ignored "$rel"; then
      die "BLOCKED: ${rel} ($(du -h "$big" 2>/dev/null | awk '{print $1}')) exceeds Vercel 100 MB limit and is NOT in .vercelignore."
    fi
  done < <(find "$ROOT" \
    \( -path "$ROOT/node_modules" -o -path "$ROOT/.git" -o -path "$ROOT/.next" -o -path "$ROOT/.vercel" \) -prune \
    -o -type f -size +95M -print 2>/dev/null)
  ok "No oversized files would upload."

  local forbidden hit=0
  while IFS= read -r forbidden; do
    [ -n "$forbidden" ] || continue
    rel="${forbidden#$ROOT/}"
    if ! _vercel_ignored "$rel"; then
      warn "FORBIDDEN on production host: $rel"
      hit=1
    fi
  done < <(find "$ROOT" -type f \( \
    -name 'OWNER.seal.bak-*' -o -name '*.pem' -o -name 'litellm-master.env' -o \
    -name 'brain.env' -o -name 'god-mode.env' -o -name '.env.local' -o -name '.env.prod' \
    \) 2>/dev/null)
  [ "$hit" = "0" ] || die "Forbidden secret/backup files would upload — fix .vercelignore or remove files."
  ok "No forbidden secret/backup files would upload."
}

DRYRUN=0; ASSUME_YES=0; PROJECT="tmmt-ops"
for a in "$@"; do
  case "$a" in
    --dry-run) DRYRUN=1 ;;
    --yes|-y)  ASSUME_YES=1 ;;
    tmmt-ops|tmmt-command-center|aixmos-landing|aixmos-offer) PROJECT="$a" ;;
    -*) die "unknown flag: $a" ;;
    *)  die "unknown project: $a (use tmmt-ops | tmmt-command-center | aixmos-landing | aixmos-offer)" ;;
  esac
done

hr; printf '  \033[1m🚀 SHIP → %s\033[0m  (production)\n' "$PROJECT"; hr

if [ -f "$ROOT/.swarm/DARK" ] || [ -f "$ROOT/auth/DARK" ]; then
  die "Base is DARK (kill-switch on). Run 'light' with the owner seal first."
fi

ship_upload_firewall

if [ ! -f "$ROOT/auth/OWNER.seal" ]; then
  die "No Owner Seal set. Run: bash scripts/owner-seal.sh seal"
fi
info "Owner Seal required — only the boss (Muhammad Taha) can ship."
if ! bash "$ROOT/scripts/owner-seal.sh" check; then
  die "Owner not verified. Deploy refused."
fi
ok "Owner verified."

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
HEAD="$(git log -1 --format='%h  %s' 2>/dev/null || echo '?')"
DIRTY="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
echo
info "Branch:  $BRANCH"
info "Commit:  $HEAD"
if [ "$DIRTY" != "0" ]; then
  warn "Working tree has $DIRTY uncommitted change(s) — they WILL be included in this deploy:"
  git status --short | sed 's/^/      /' | head -20
  [ "$DIRTY" -gt 20 ] && warn "      … and $((DIRTY - 20)) more"
fi
echo

info "Building locally to verify (npm run build)…"
rm -f "$ROOT/.next/lock" 2>/dev/null
if npm run build > /tmp/ship-build.log 2>&1; then
  ok "Local build passed."
else
  echo; tail -25 /tmp/ship-build.log
  die "Local build FAILED — fix it before shipping. (full log: /tmp/ship-build.log)"
fi

if [ "$DRYRUN" = "1" ]; then
  echo; ok "DRY RUN complete — everything passed. No deploy was made."
  info "When the owner is ready: bash scripts/ship $PROJECT"
  exit 0
fi

if [ "$ASSUME_YES" != "1" ]; then
  echo; hr
  printf '  This will publish to PRODUCTION: \033[1m%s\033[0m\n' "$PROJECT"
  printf '  Type exactly  \033[1mDEPLOY\033[0m  to ship (anything else aborts):\n  > '
  IFS= read -r confirm
  [ "$confirm" = "DEPLOY" ] || die "Not confirmed. Aborted — nothing deployed."
fi

command -v vercel >/dev/null 2>&1 || die "vercel CLI not found. npm i -g vercel"
info "Linking project ${PROJECT}..."
vercel link --yes --project "$PROJECT" --scope aixmos537 >/dev/null 2>&1 || die "could not link $PROJECT"
ok "Linked $PROJECT."
info "Deploying to production… (Vercel builds with the project's own env)"
if vercel deploy --prod --yes; then
  echo; ok "Shipped $PROJECT to production. 🎉"
  info "Verify the live URL, then you're done."
else
  die "Deploy failed (see output above). Nothing was promoted if the build errored."
fi
