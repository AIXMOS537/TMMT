#!/usr/bin/env bash
# go — the ONE command. Updates everything and boots the whole base in unison.
# Self-sufficient: finds the repo, learns its own remote, self-heals, and installs
# a permanent `unison` shortcut so next time you just type one word.
set -uo pipefail
BRANCH="${TMMT_BRANCH:-claude/organize-chats-sessions-7t7zjy}"

locate() {
  git rev-parse --show-toplevel 2>/dev/null && return
  local d
  for d in "$HOME/Projects/TMMT" "$HOME/projects/TMMT" "$HOME/TMMT" \
           "$HOME/Documents/TMMT" "$HOME/Desktop/TMMT"; do
    [ -d "$d/.git" ] && { printf '%s' "$d"; return; }
  done
  d="$(find "$HOME" -maxdepth 4 -type d -name .git -path '*/TMMT/.git' 2>/dev/null | head -1)"
  [ -n "$d" ] && dirname "$d"
}

R="$(locate)"
if [ -z "${R:-}" ]; then
  R="$HOME/TMMT"
  echo "› cloning into $R"
  git clone "${TMMT_REPO:-https://github.com/AIXMOS537/TMMT.git}" "$R" \
    || { echo "✗ clone failed — set TMMT_REPO to your repo URL and re-run"; exit 1; }
fi
cd "$R" || exit 1
echo "› repo: $R"

# Update (never blocked by local edits, never fatal when offline).
git stash push -u -m "auto $(date -u +%FT%TZ)" >/dev/null 2>&1 || true
git fetch origin "$BRANCH" >/dev/null 2>&1 || git fetch origin >/dev/null 2>&1 || true
git checkout "$BRANCH" >/dev/null 2>&1 || true
git pull origin "$BRANCH" >/dev/null 2>&1 || echo "! offline — booting on-disk code"

# Self-heal: make tools runnable + install the secret-guard hooks.
chmod +x "$R"/scripts/go "$R"/scripts/tmmt "$R"/scripts/hailmary \
         "$R"/scripts/mesh/*.sh "$R"/TMMT-GO.command 2>/dev/null || true
git config core.hooksPath scripts/hooks 2>/dev/null || true

# Install permanent one-word shortcuts so you never type a path again.
# Idempotent: rewrite the block between guards every run (handles path changes).
install_words() {
  local rc="$1" tmp; tmp="$(mktemp)"
  [ -e "$rc" ] && grep -v 'TMMT_WORDS' "$rc" > "$tmp" 2>/dev/null || true
  {
    echo "# TMMT_WORDS (auto-managed by scripts/go — one word does the thing)"
    echo "alias unison='bash \"$R/scripts/go\"'        # TMMT_WORDS"
    echo "alias base='bash \"$R/scripts/go\"'          # TMMT_WORDS"
    echo "alias menu='bash \"$R/scripts/menu\"'        # TMMT_WORDS"
    echo "alias booyah='bash \"$R/scripts/hailmary\" booyah'   # TMMT_WORDS"
    echo "alias hailmary='bash \"$R/scripts/hailmary\" status' # TMMT_WORDS"
    echo "alias onboard='bash \"$R/scripts/aixmos\" onboard'   # TMMT_WORDS"
    echo "alias aixmos='bash \"$R/scripts/aixmos\" roster'     # TMMT_WORDS"
  } >> "$tmp"
  mv "$tmp" "$rc"
}
for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do install_words "$rc"; done
echo "› one-word commands ready (new terminal): unison · menu · booyah · onboard · aixmos · hailmary"

bash "$R/scripts/menu" || true
exec bash "$R/scripts/tmmt" unison
