#!/usr/bin/env bash
# invite — hand me the exact message to send someone, ready to paste. Copies it
# to your clipboard (macOS) so you just paste into Messages/WhatsApp/Mail.
# No more asking Claude to "write the message."
#
#   invite immediate          inner-circle family welcome
#   invite extended           extended-family welcome
#   invite friends            friends welcome
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd 2>/dev/null || echo "$PWD")"
WHO="${1:-}"; NAME="${2:-}"
SETUP1='curl -fsSL https://raw.githubusercontent.com/AIXMOS537/TMMT/master/scripts/setup-mac.command -o ~/Downloads/setup.command && bash ~/Downloads/setup.command'

msg_immediate(){ cat <<EOF
You're my inner circle, so you're the first I'm bringing in. This is yours —
your own private helper on your own computer. ~5 min:

1) Open Terminal (Cmd+Space → type Terminal → Enter) and paste:
   $SETUP1
2) When it asks who it's for, pick:  MY OWN  (keeps it 100% yours)
3) Open a new Terminal and type:  menu

That's it. You can't break it. Anything you need, call me. 💛 — Taha
EOF
}
msg_extended(){ cat <<EOF
Family is family — this is for you. Your own private helper, on your own machine. ~5 min:

1) Open Terminal (Cmd+Space → type Terminal → Enter) and paste:
   $SETUP1
2) When it asks who it's for, pick:  MY OWN
3) Open a new Terminal and type:  menu

Play with it, you can't break it. Stuck? Text me. 🧡 — Taha
EOF
}
msg_friends(){ cat <<EOF
Real ones only — that's why you're getting this. Your own private helper, on your
own machine, free. ~5 min:

1) Open Terminal (Cmd+Space → type Terminal → Enter) and paste:
   $SETUP1
2) When it asks who it's for, pick:  MY OWN
3) Open a new Terminal and type:  menu   (want to build a business? type: member)

Hit me up if you get stuck. 💙 — Taha
EOF
}

case "$WHO" in
  immediate|family)     OUT="$(msg_immediate)"; SUBJECT="Welcome — your own private system";;
  extended)             OUT="$(msg_extended)";  SUBJECT="Welcome — your own private system";;
  friends|friend)       OUT="$(msg_friends)";   SUBJECT="For you — your own private system";;
  *) echo "invite: immediate | extended | friends   (add an email to open Mail pre-written)"; exit 0;;
esac

printf '\n%s\n' "$OUT"

# Copy to clipboard (macOS) so it's paste-ready anywhere.
if command -v pbcopy >/dev/null 2>&1; then
  printf '%s' "$OUT" | pbcopy && printf '\n\033[32m✓ copied to your clipboard.\033[0m\n'
fi

# If any arg is an email address, open Mail fully written + addressed (all local).
EMAIL=""; for a in "$@"; do case "$a" in *@*.*) EMAIL="$a";; esac; done
if [ -n "$EMAIL" ] && command -v open >/dev/null 2>&1; then
  URL="$(SUBJECT="$SUBJECT" BODY="$OUT" EMAIL="$EMAIL" python3 -c '
import os,urllib.parse
q=urllib.parse.urlencode({"subject":os.environ["SUBJECT"],"body":os.environ["BODY"]})
print("mailto:%s?%s"%(os.environ["EMAIL"],q))')"
  open "$URL" && printf '\033[32m✓ opened Mail to %s — written + addressed. Just hit Send.\033[0m\n\n' "$EMAIL"
else
  printf '\n(paste it into Messages/Mail, or re-run with an email to open Mail: invite %s %s their@email.com)\n\n' "$WHO" "${NAME:-}"
fi
