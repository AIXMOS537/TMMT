#!/usr/bin/env bash
# moe-brief — the operator's daily briefing. Offline-safe, read-only, fenced.
# Greets the operator, reloads the compliance non-negotiables, the ladder, the
# contact window, and points at where the real work lives (GHL). No network, no
# secrets, no fabricated data — it's a "start your day right" board.
#
#   bash scripts/moe-brief      today's briefing
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ -t 1 ]]; then
  G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; R=$'\e[31m'; W=$'\e[97m'; D=$'\e[2m'; BD=$'\e[1m'; X=$'\e[0m'
else G=; Y=; C=; R=; W=; D=; BD=; X=; fi

# Operator identity (written by umar-setup.command). Falls back gracefully.
NAME="operator"
ENVF="$HOME/.config/tmmt/red-hood.env"
[[ -f "$ENVF" ]] && NAME="$(grep -E '^OPERATOR_NAME=' "$ENVF" 2>/dev/null | head -1 | cut -d= -f2-)"
[[ -z "${NAME:-}" ]] && NAME="operator"

DATE="$(date '+%A, %B %-d, %Y')"
HOUR="$(date +%-H)"
if   [[ $HOUR -lt 12 ]]; then GREET="Good morning"
elif [[ $HOUR -lt 17 ]]; then GREET="Good afternoon"
else GREET="Good evening"; fi

printf '\n%s   ☀  M O E   B R I E F%s\n%s   %s, %s — %s%s\n\n' "$C$BD" "$X" "$D" "$GREET" "$NAME" "$DATE" "$X"

# Kill-switch awareness — work words are blocked while DARK.
if [[ -f "$ROOT/.swarm/DARK" ]]; then
  printf '%s   ⛔ DARK is ON — everything is stopped. No client work until lifted.%s\n' "$R$BD" "$X"
  printf '%s   Read-only briefing below. Reach the boss: sos "why are we dark?"%s\n\n' "$D" "$X"
fi

printf '%s   THE LADDER — everyone climbs it, no skipping:%s\n' "$Y$BD" "$X"
printf '     🚗 Rental ($0)  →  💳 Membership ($97/mo)  →  📈 Credit Guidance\n'
printf '     →  💰 Funded  →  🏗️  Builds & Kits  →  🤝 Affiliate (recurring)\n\n'

printf '%s   COMPLIANCE — the non-negotiables (read every morning):%s\n' "$R$BD" "$X"
printf '     ✓ Say "credit guidance"        ✗ never "credit repair"\n'
printf '     ✓ Say "subject to lender approval"  ✗ never guarantee scores/amounts\n'
printf '     ✓ AI disclaimer is the FIRST sentence of every AI chat\n'
printf '     ✓ Honor STOP instantly — remove + log    ✗ no upfront charge (CROA)\n'
printf '     ✓ Texting window: 8:00am – 9:00pm local only\n\n'

printf '%s   TODAY:%s\n' "$G$BD" "$X"
printf '     1. moe-hot       — see your hottest leads + the next action for each\n'
printf '     2. GHL Mobile    — work conversations, campaigns, pipeline\n'
printf '     3. guide         — credit-guidance score tiers + first-call checklist\n'
printf '     4. work          — start your assigned tasks\n'
printf '     5. compass       — protect your peace; you first, then the work\n\n'

printf '%s   Stuck on anything? %ssos "your question"%s%s reaches Muhammad Taha.%s\n\n' "$D" "$BD$W" "$X" "$D" "$X"
