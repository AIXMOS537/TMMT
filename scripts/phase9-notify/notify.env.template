# Copy to scripts/phase9-notify/.env.notify (gitignored) and fill in real values.
#
# Usage:
#   cp scripts/phase9-notify/notify.env.template scripts/phase9-notify/.env.notify
#   # edit .env.notify with real values
#   set -a; source scripts/phase9-notify/.env.notify; set +a
#   ./scripts/phase9-notify/set-vercel-notify-env.sh

# Slack — https://api.slack.com/apps → Incoming Webhooks → Add to #sales
SLACK_WEBHOOK_URL=

# Telegram — @BotFather (token), @userinfobot (chat ID), then DM your new bot once to enable sends
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# iMessage — deferred. Leave blank unless you've stood up the work-Mac relay + tunnel
# (see README.md Step 3 for why this isn't wired by default).
IMESSAGE_RELAY_URL=
IMESSAGE_NOTIFY_TO=
IMESSAGE_RELAY_TOKEN=
