# Copy to .env in this folder (never commit .env)
# BotFather → /newbot → TELEGRAM_BOT_TOKEN

TELEGRAM_BOT_TOKEN=

# Comma-separated numeric chat IDs (only these users can run commands).
# Get your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: after each Telegram command, also text this iMessage / SMS handle
# (phone +15551234567 or email Apple ID). Requires Messages signed in on the Mac.
IMESSAGE_BUDDY=

# Set 1 to send iMessage confirmations when IMESSAGE_BUDDY is set
TELEGRAM_REPLY_IMESSAGE=0

# --- Optional iMessage *inbound* watcher (reads Messages database; off by default) ---
IMESSAGE_WATCHER_ENABLED=0
# Comma-separated handles that may send commands (must match Messages "info" id)
IMESSAGE_ALLOWED_HANDLES=
# Incoming texts must start with this prefix (e.g. "TMMT ")
IMESSAGE_CMD_PREFIX=TMMT

# Reply on iMessage after each inbound command (1 = on)
IMESSAGE_REPLY_ENABLED=1

# --- TMMT OS ops (natural language cases, GHL, assignments) ---
# Dev server must be running: bash scripts/enable-office-services.sh
TMMT_OPS_URL=http://127.0.0.1:3000/api/ops/command
# Loaded automatically from tmmt-os/.env.local if unset here:
# OPS_COMMAND_SECRET=
