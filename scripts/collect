#!/usr/bin/env bash
# collect — bundle YOUR work on THIS machine into one folder to hand off.
# Run on the operator's machine. It copies the folder(s)
# you point at (originals untouched) into a dated handoff folder on the Desktop,
# writes a file list, and opens Finder so you AirDrop/send it.
#
# SAFE: secrets + junk are never included — .env, keys, vault, .git, node_modules,
# caches, and the owner seal are all skipped.
#
#   bash scripts/collect <folder> [more folders...]   bundle those folders
#   bash scripts/collect                              asks you to point at one
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd 2>/dev/null || echo "$PWD")"
if [[ -t 1 ]]; then G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; W=$'\e[97m'; D=$'\e[2m'; BD=$'\e[1m'; X=$'\e[0m'; else G=; Y=; C=; W=; D=; BD=; X=; fi
ok(){ printf '%s  ✓ %s%s\n' "$G" "$*" "$X"; }
say(){ printf '%s\n' "$*"; }
# Belt-and-suspenders: strip secrets/junk from a copied tree (works even without rsync).
_scrub(){
  local d="$1"
  find "$d" -type f \( -name '.env' -o -name '.env.*' -o -name '*.key' -o -name '*.pem' \
    -o -name 'id_rsa*' -o -name 'id_ed25519*' -o -name '*.enc' -o -name 'OWNER.seal' \
    -o -name '.DS_Store' \) -delete 2>/dev/null || true
  find "$d" -type d \( -name '.git' -o -name 'node_modules' -o -name '.cache' \) -prune -exec rm -rf {} + 2>/dev/null || true
}

NAME="handoff"
[ -s "$ROOT/.swarm/machine" ] && NAME="$(tr -d '[:space:]' < "$ROOT/.swarm/machine")"

# Folders to bundle: from args, or ask.
FOLDERS=("$@")
if [ "${#FOLDERS[@]}" -eq 0 ]; then
  say
  say "  ${BD}What work do you want to hand off?${X}"
  say "  Drag your work folder into this window (or type its path), then press Enter:"
  printf '  > '; IFS= read -r f || true
  f="${f//\\/}"; f="$(printf '%s' "$f" | sed "s/^['\"]//;s/['\"]$//;s/[[:space:]]*$//")"
  [ -n "$f" ] && FOLDERS=("$f")
fi
[ "${#FOLDERS[@]}" -gt 0 ] || { echo "  (nothing to collect)"; exit 0; }

DEST="$HOME/Desktop/HANDOFF-$NAME-$(date +%Y%m%d-%H%M)"
mkdir -p "$DEST"
say
say "  ${C}${BD}Collecting your work → $DEST${X}"

EXCLUDES=(--exclude='.git' --exclude='node_modules' --exclude='.DS_Store'
  --exclude='.env' --exclude='.env.*' --exclude='*.key' --exclude='*.pem'
  --exclude='id_rsa*' --exclude='id_ed25519*' --exclude='*.enc'
  --exclude='OWNER.seal' --exclude='.hailmary' --exclude='.memorial'
  --exclude='.swarm' --exclude='Library' --exclude='*.log' --exclude='.cache')

for src in "${FOLDERS[@]}"; do
  [ -e "$src" ] || { printf '%s  ! skipped (not found): %s%s\n' "$Y" "$src" "$X"; continue; }
  base="$(basename "$src")"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a "${EXCLUDES[@]}" "$src/" "$DEST/$base/" 2>/dev/null \
      || rsync -a "${EXCLUDES[@]}" "$src" "$DEST/" 2>/dev/null || true
  else
    cp -R "$src" "$DEST/" 2>/dev/null || true
  fi
  ok "added: $base"
done

# Strip any secrets/junk that slipped through (no rsync, or odd names).
_scrub "$DEST"

# A simple file list + a note for the owner.
( cd "$DEST" && find . -type f ! -name 'FILE-LIST.txt' 2>/dev/null | sed 's|^\./||' | sort > FILE-LIST.txt )
COUNT="$(grep -c . "$DEST/FILE-LIST.txt" 2>/dev/null || echo 0)"
cat > "$DEST/READ-ME-FIRST.txt" <<EOF
OPERATOR work handoff — from: $NAME
Made: $(date)
Files: $COUNT   (FILE-LIST.txt has the full list)

No secrets are in here (keys/.env/vault skipped on purpose).

TO SEND: select everything in this folder → AirDrop (or Messages/Mail) to
PROJECT X HAILMARY. He'll pull it into the system with:  intake <this folder>
EOF

ok "done — $COUNT file(s) bundled, no secrets included"
command -v open >/dev/null 2>&1 && open "$DEST" 2>/dev/null || true
say "$D   AirDrop this whole folder to PROJECT X HAILMARY.$X"
