#!/usr/bin/env bash
# wiki — the Karpathy-style dropdown wiki. Plain markdown is the source of truth
# (LLM-native, git-synced); this builds a single OFFLINE html home page with
# collapsible <details> dropdowns — your home base, instead of Obsidian.
#
#   bash scripts/wiki build     (re)generate tools/wiki/index.html from docs/
#   bash scripts/wiki open      build + open it in the browser
#   bash scripts/wiki           same as open
#
# No external deps, no internet needed. Plug-and-play on any machine that has
# the repo. Method: docs/WIKI-DROPDOWN-METHOD.md
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/tools/wiki/index.html"
mkdir -p "$ROOT/tools/wiki"

esc(){ sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
title_of(){ awk '/^# /{sub(/^# +/,"");print;exit}' "$1"; }
blurb_of(){ awk 'f&&/^> /{sub(/^> +/,"");print;exit} /^# /{f=1}' "$1"; }

# Curated HOME BASE — the files you live in (file|emoji label)
HOME_PINS="
docs/ARCHITECT-COCKPIT.md|🛰️ Architect's Cockpit (3D)
docs/FLEET-ROSTER.md|🖥️ Fleet Roster (devices)
docs/BRAINIAC-MAC-SETUP.md|🧠 Brain Setup (M1)
docs/BRAINIAC-RESILIENCE.md|🛡️ Brain Resilience
docs/HOMELAND-HQ-AND-OPERATOR-SEATS.md|🏠 Homeland HQ + Seats
docs/DMV-CLUBHOUSE-OFFICE.md|🏢 DMV Clubhouse
docs/OFFER-STACK.md|💰 Offer Stack (pricing)
docs/LEARN-EARN-CHURN.md|🎮 Learn·Earn·Churn
docs/security/GO-GHOST-PROTOCOL.md|👻 Go Ghost Protocol
docs/WIKI-DROPDOWN-METHOD.md|📚 This Wiki Method
"

entry(){ # path | label-override(optional)
  local f="$1" override="${2:-}"
  [ -f "$ROOT/$f" ] || return 0
  local t b; t="$(title_of "$ROOT/$f" | esc)"; [ -n "$override" ] && t="$override"
  b="$(blurb_of "$ROOT/$f" | esc)"
  printf '<a class="card" href="../../%s"><div class="t">%s</div><div class="b">%s</div><div class="p">%s</div></a>\n' \
    "$f" "${t:-$f}" "${b:-—}" "$f"
}

build(){
  local now; now="$(date '+%Y-%m-%d %H:%M')"
  {
  cat <<'HEAD'
<!doctype html><html lang="en"><head><meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>AIXMOS · Wiki</title>
<style>
:root{--cy:#00e5ff;--mg:#ff3ea5;--gd:#ffd54f;--gr:#69f0ae;--bg:#03040a;--pan:#0a1422;}
*{box-sizing:border-box;margin:0;padding:0}
body{background:radial-gradient(1200px 700px at 70% -10%,#0a1f33,#03040a);color:#dff3ff;
 font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",sans-serif;min-height:100vh;padding:26px 22px 60px}
header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:18px}
h1{font-size:18px;letter-spacing:3px;text-shadow:0 0 16px var(--cy)}
h1 span{color:var(--cy)}
.sub{font-size:11px;opacity:.55;letter-spacing:1px;margin-top:3px}
.tools{display:flex;gap:10px;flex-wrap:wrap}
.btn{cursor:pointer;text-decoration:none;font-size:12px;letter-spacing:1px;color:#bfefff;
 background:rgba(0,229,255,.08);border:1px solid rgba(0,229,255,.32);border-radius:10px;padding:9px 14px;transition:.15s}
.btn:hover{background:rgba(0,229,255,.22);color:#fff}
.btn.mg{color:#ffc6e2;background:rgba(255,62,165,.08);border-color:rgba(255,62,165,.32)}
.btn.mg:hover{background:rgba(255,62,165,.22);color:#fff}
#q{width:100%;max-width:420px;padding:11px 14px;border-radius:10px;border:1px solid rgba(0,229,255,.25);
 background:#06101c;color:#dff3ff;font-size:13px;margin:6px 0 20px}
details{background:linear-gradient(160deg,rgba(10,20,34,.8),rgba(4,8,18,.8));border:1px solid rgba(255,255,255,.08);
 border-radius:14px;margin:0 0 14px;overflow:hidden}
summary{cursor:pointer;padding:15px 18px;font-size:13px;letter-spacing:1.5px;font-weight:700;list-style:none;
 display:flex;justify-content:space-between;align-items:center}
summary::-webkit-details-marker{display:none}
summary .c{opacity:.45;font-weight:400;font-size:11px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;padding:4px 16px 18px}
.card{display:block;text-decoration:none;color:inherit;background:#06101c;border:1px solid rgba(0,229,255,.14);
 border-radius:11px;padding:13px 15px;transition:.15s}
.card:hover{border-color:var(--cy);box-shadow:0 0 22px rgba(0,229,255,.12);transform:translateY(-2px)}
.card .t{font-size:13.5px;font-weight:600;color:#fff;margin-bottom:5px}
.card .b{font-size:11.5px;opacity:.7;line-height:1.5;max-height:3.4em;overflow:hidden}
.card .p{font-size:10px;opacity:.32;margin-top:8px;font-family:ui-monospace,Menlo,monospace}
.foot{opacity:.4;font-size:11px;margin-top:24px;line-height:1.8}
.hide{display:none!important}
</style></head><body>
<header>
  <div><h1><span>◆</span> AIXMOS · WIKI</h1><div class="sub">YOUR HOME BASE · COLLAPSIBLE DROPDOWNS · OFFLINE · GIT-SYNCED</div></div>
  <div class="tools">
    <a class="btn mg" href="../hologram-cockpit/index.html">🛰️ OPEN 3D COCKPIT</a>
    <a class="btn" href="https://github.com/AIXMOS537/TMMT" target="_blank">⎘ GITHUB (rendered)</a>
  </div>
</header>
<input id="q" placeholder="🔎 filter everything…" oninput="filt(this.value)"/>
HEAD

  # HOME BASE group (open by default)
  echo '<details open><summary>🏠 HOME BASE — what you live in <span class="c">pinned</span></summary><div class="grid">'
  echo "$HOME_PINS" | while IFS='|' read -r f lbl; do [ -n "$f" ] && entry "$f" "$lbl"; done
  echo '</div></details>'

  # ALL DOCS group
  local count; count="$(find "$ROOT/docs" -maxdepth 2 -name '*.md' | wc -l | tr -d ' ')"
  echo "<details><summary>📂 ALL DOCUMENTATION <span class=\"c\">${count} files</span></summary><div class=\"grid\">"
  find "$ROOT/docs" -maxdepth 2 -name '*.md' | sort | while read -r abs; do
    entry "${abs#$ROOT/}"
  done
  echo '</div></details>'

  cat <<FOOT
<div class="foot">
Source of truth = the markdown files (LLM-native, git-diffable). This page is generated:
<code>bash scripts/wiki build</code> · last built ${now}.<br>
Method: docs/WIKI-DROPDOWN-METHOD.md · Cockpit: tools/hologram-cockpit/index.html
</div>
<script>
function filt(v){v=v.toLowerCase();document.querySelectorAll('.card').forEach(c=>{
 c.classList.toggle('hide',!c.innerText.toLowerCase().includes(v));});
 document.querySelectorAll('details').forEach(d=>{ if(v) d.open=true; });}
</script>
</body></html>
FOOT
  } > "$OUT"
  echo "✓ built $OUT"
}

open_it(){
  if   command -v open     >/dev/null 2>&1; then open "$OUT"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$OUT"
  elif command -v start    >/dev/null 2>&1; then start "" "$OUT"
  else echo "Open in a browser: $OUT"; fi
}

case "${1:-open}" in
  build) build ;;
  open|"") build; open_it ;;
  *) echo "usage: wiki [build|open]"; exit 1 ;;
esac
