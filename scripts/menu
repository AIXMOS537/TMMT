#!/usr/bin/env bash
# menu — the picture board. One colorful screen of every one-word command.
#   bash scripts/menu      (or just type:  menu )
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROLE="${SWARM_ROLE:-}"; [ -z "$ROLE" ] && [ -f "$ROOT/.swarm/role" ] && ROLE="$(tr -d '[:space:]' < "$ROOT/.swarm/role")"
[ -z "$ROLE" ] && ROLE=operator

if [[ -t 1 ]]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'; M=$'\e[35m'; C=$'\e[36m'
  W=$'\e[97m'; D=$'\e[2m'; BD=$'\e[1m'; X=$'\e[0m'
  BGB=$'\e[44m'; BGM=$'\e[45m'
else
  R=; G=; Y=; B=; M=; C=; W=; D=; BD=; X=; BGB=; BGM=
fi

printf '\n%s%s   ╔══════════════════════════════════════════════════════════╗%s\n' "$C" "$BD" "$X"
printf '%s%s   ║%s        🤖  T M M T   ·   A I X M O S   ·   H A I L M A R Y      %s║%s\n' "$C" "$BD" "$W" "$C" "$X"
printf '%s%s   ║%s        one word does the thing · %s · local       %s%s%s║%s\n' "$C" "$BD" "$D" "$ROLE" "$X" "$C" "$BD" "$X"
printf '%s%s   ╚══════════════════════════════════════════════════════════╝%s\n\n' "$C" "$BD" "$X"

if [ "$ROLE" = "owner" ]; then
cat <<EOF
${BGB}${W}${BD}  🚀  START  ${X}
   ${G}${BD}booyah${X}      ${D}—${X} ⚡ THE start word — boot the whole base, everything online
   ${G}${BD}menu${X}        ${D}—${X} 🗺️  show this picture board

${BGM}${W}${BD}  🦾  WATCH  (Cyborg's post) ${X}
   ${M}${BD}watchtower${X}  ${D}—${X} 🛰️  the League + live health of every vertical
   ${M}${BD}health${X}      ${D}—${X} 📊 each business up / down at a glance
   ${M}${BD}whoami${X}      ${D}—${X} 👁️  this device · role · gate · dark/clear

${BGM}${W}${BD}  🧠  CLIENTS  ${X}
   ${M}${BD}onboard${X}     ${D}—${X} 🪜 the 10-step popup — decode a client to the foundation
   ${M}${BD}aixmos${X}      ${D}—${X} 👥 the cast (CAPTAIN·MOOSE·CHUMMO·SCOUT·CLOSER·WARDEN)

${R}${BD}  ❤️  YOU FIRST  ${X}
   ${C}${BD}compass${X}     ${D}—${X} ☾ one gentle step · protect your peace · toward God
   ${C}${BD}compass help${X}${D} —${X} 🤲 if today is heavy — real support, one breath

${Y}${BD}  🛡️  PROTECT  ${X}
   ${Y}${BD}dark${X}        ${D}—${X} ⛔ STOP everything now   (${BD}dark hard${X}${D} = cut network)${X}
   ${Y}${BD}light${X}       ${D}—${X} 🔓 restore — your word only
   ${Y}${BD}fix${X}         ${D}—${X} 🔒 security + health check    ${Y}${BD}seal${X} ${D}—${X} 🔑 owner gate

${D}  more:  wake (HAILMARY only) · hailmary (status) · mesh · deploy · hit 2 (build)${X}
EOF
else
cat <<EOF
${BGB}${W}${BD}  🚀  YOUR DAY  ${X}
   ${G}${BD}menu${X}        ${D}—${X} 🗺️  show this board
   ${G}${BD}brief${X}       ${D}—${X} ☀️  daily briefing — ladder + compliance + today's actions
   ${G}${BD}hot${X}         ${D}—${X} 🔥 hottest leads + next action for each
   ${G}${BD}work${X}        ${D}—${X} 💪 start your assigned work
   ${G}${BD}sync${X}        ${D}—${X} 🔄 pull/push the latest
   ${G}${BD}who${X}         ${D}—${X} 🌐 who's online right now

${BGM}${W}${BD}  🦾  WATCH  ${X}
   ${M}${BD}whoami${X}      ${D}—${X} 👁️  this device · role
   ${M}${BD}watchtower${X}  ${D}—${X} 🛰️  the League + system health

${R}${BD}  ❤️  YOU FIRST  ${X}
   ${C}${BD}compass${X}     ${D}—${X} ☾ one gentle step · protect your peace · toward God
   ${C}${BD}compass help${X}${D} —${X} 🤲 if today is heavy — real support, one breath

${Y}${BD}  🆘  NEED A HAND  ${X}
   ${Y}${BD}sos${X}         ${D}—${X} 📣 reach the owner (e.g. sos "stuck on intake")
   ${Y}${BD}dark${X}        ${D}—${X} ⛔ stop everything (panic button)
   ${Y}${BD}update${X}      ${D}—${X} ⬇️  get the latest version
EOF
fi

cat <<EOF

${B}${BD}  🪜  THE LADDER  (locked) ${X}
   ${W}🚗 Rental ${D}→${X} ${W}💳 Membership ${D}→${X} ${W}📈 Credit Guidance ${D}→${X} ${W}🏗️ Builds/Kits ${D}→${X} ${W}🤝 Affiliate${X}

${D}   new device? see DEPLOY-EVERYWHERE.md · phone? see MOBILE.md${X}

EOF
