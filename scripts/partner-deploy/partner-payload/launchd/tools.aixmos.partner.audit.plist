<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tools.aixmos.partner.audit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__INSTALL_DIR__/audit-shipper.py</string>
    </array>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/aixmos-partner/audit.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/aixmos-partner/audit.err.log</string>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
