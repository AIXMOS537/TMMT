// Tailscale ACL — paste into https://login.tailscale.com/admin/acls
//
// Per design spec §12. Narrows partner Macs to a tiny set of destinations:
//   - NAS SMB + NFS
//   - lic.tmmt.tools (v2; v1 uses Supabase directly)
//   - log.tmmt.tools (v2; v1 uses Supabase directly)
//   - partner.tmmt-ops.com (v2; v1 uses tmmt-ops.vercel.app)
//
// Partner Macs CANNOT reach: BRAINIAC, ceo.moe's other Macs, iPhones, any
// other partner Mac.
//
// IMPORTANT — fill the placeholders below before applying:
//   - <NAS_TAILNET_IP>   ← from `tailscale status` on the NAS node
//   - <OWNER_USER>       ← your Tailscale login email
//
// Then add the per-partner tag (e.g., tag:partner-moe) under tagOwners.
// One tag per partner, all owned by autogroup:admin.

{
  "tagOwners": {
    "tag:partner-moe":    ["autogroup:admin"]
    // future:  "tag:partner-<name>": ["autogroup:admin"]
  },

  "acls": [
    // Owner-side hosts get unrestricted access (default behavior — owner-side
    // ACLs already in place outside this snippet should remain).

    // Partner Macs: allow ONLY the narrow lane
    {
      "action": "accept",
      "src":    ["tag:partner-moe"],
      "dst": [
        "<NAS_TAILNET_IP>:445",            // NAS SMB
        "<NAS_TAILNET_IP>:2049",           // NAS NFS (if used)
        "lic.tmmt.tools:443",              // license server (v2)
        "log.tmmt.tools:443",              // audit log server (v2)
        "partner.tmmt-ops.com:443"         // partner UI (v2)
      ]
    }

    // Implicit deny on everything else — partner Macs cannot reach BRAINIAC
    // (100.117.163.93), iPhones, owner Macs, or any other partner Mac.
  ],

  "tests": [
    // Verify partner-moe CAN reach the NAS
    {
      "src":    "tag:partner-moe",
      "accept": ["<NAS_TAILNET_IP>:445"]
    },
    // Verify partner-moe CANNOT reach BRAINIAC
    {
      "src":  "tag:partner-moe",
      "deny": ["100.117.163.93:22", "100.117.163.93:443"]
    },
    // Verify partner-moe CANNOT reach owner's M5
    // (substitute owner's tailnet IP from `tailscale status`)
    {
      "src":  "tag:partner-moe",
      "deny": ["100.77.126.8:22"]
    }
  ]
}
