#!/usr/bin/env bash
# Pre-push backstop:
#   1) refuse to push if any secret file is tracked,
#   2) protect master/main from force-push + delete (silently wipes merged work),
#   3) (if gitleaks present) scan the commits being pushed for secrets,
#   4) LOCAL-FIRST GATE: refuse to push BROKEN app code (lint/test/build).
set -uo pipefail
red() { printf '\e[31m%s\e[0m\n' "$*" >&2; }
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
ZERO="0000000000000000000000000000000000000000"

# Read the ref list from stdin ONCE — every loop below shares it (stdin can only
# be read a single time). git feeds: <local_ref> <local_sha> <remote_ref> <remote_sha>.
refs_input="$(cat)"

# 1) No tracked env/key files anywhere in the index (catches an earlier mistake).
tracked_secrets="$(git ls-files | grep -Ei '(^|/)\.env(\.|$)|\.pem$|\.p12$|\.pfx$|(^|/)id_(rsa|ed25519|dsa)$' | grep -v '\.example$' || true)"
if [[ -n "$tracked_secrets" ]]; then
  red "BLOCKED push: secret file(s) are tracked in git:"
  printf '   %s\n' $tracked_secrets >&2
  red "Remove from history: git rm --cached <file>  (and rotate the secret)."
  exit 1
fi

# 2) Protect master/main from force-pushes and deletes — this is what silently
#    wiped already-merged work. A rewrite of shared history is almost never
#    intended; require a loud, explicit override for the rare true emergency:
#      ALLOW_FORCE_MASTER=1 git push ...      (owner, deliberate recovery only)
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      if [[ "$local_sha" == "$ZERO" ]]; then
        red "BLOCKED: refusing to DELETE $remote_ref. Protected branch."
        exit 1
      fi
      if [[ "$remote_sha" != "$ZERO" ]] \
         && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        if [[ "${ALLOW_FORCE_MASTER:-}" == "1" ]]; then
          red "WARNING: force-push to $remote_ref allowed via ALLOW_FORCE_MASTER=1."
        else
          red "BLOCKED: refusing to FORCE-PUSH $remote_ref (non-fast-forward)."
          red "This rewrites shared history and silently deletes merged work."
          red "If you truly must, re-run with:  ALLOW_FORCE_MASTER=1 git push ..."
          exit 1
        fi
      fi
      ;;
  esac
done <<< "$refs_input"

# 3) gitleaks over ONLY the commits being pushed (not full history).
if command -v gitleaks >/dev/null 2>&1; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_sha:-}" ]] && continue
    [[ "$local_sha" == "$ZERO" ]] && continue
    if [[ "$remote_sha" == "$ZERO" ]]; then
      # New remote branch: scan only what is NEW relative to the default branch.
      # "$local_sha" alone means the whole reachable history, so one old leak
      # anywhere in master's past blocked every new branch forever (2026-09-08).
      base="$(git merge-base "$local_sha" origin/master 2>/dev/null || git merge-base "$local_sha" master 2>/dev/null || true)"
      if [[ -n "$base" && "$base" != "$local_sha" ]]; then range="$base..$local_sha"; else range="$local_sha"; fi
    else
      range="$remote_sha..$local_sha"
    fi
    gitleaks detect --no-banner --redact --log-opts="$range" 2>/dev/null \
      || { red "BLOCKED push by gitleaks (secret in NEW commits being pushed)."; exit 1; }
  done <<< "$refs_input"
fi

# 4) Local-first gate: refuse to push BROKEN app code. Scoped to commits that
# touch app paths so docs/scripts pushes stay fast. Emergency escape hatch
# (use sparingly, and own it): SKIP_VERIFY=1 git push ...
APP_PATHS='^(src/|public/|packages/|package\.json|package-lock\.json|next\.config\.|middleware\.ts|tsconfig\.json|postcss\.config\.|sentry\.|instrumentation\.ts|vercel\.json)'
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  [[ "$local_sha" == "$ZERO" ]] && continue
  if [[ "$remote_sha" == "$ZERO" ]]; then range_files="$(git diff --name-only "$local_sha" 2>/dev/null || true)"
  else range_files="$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)"; fi
  if printf '%s\n' "$range_files" | grep -qE "$APP_PATHS"; then
    if [[ "${SKIP_VERIFY:-}" == "1" ]]; then
      red "SKIP_VERIFY=1 set — bypassing the local build/test gate (emergency only)."
    else
      printf '\e[1mApp code changed — running the local-first gate before push…\e[0m\n' >&2
      if ! bash "$REPO_ROOT/scripts/verify.sh" >&2; then
        red "BLOCKED push: local checks failed. Nothing reaches master/live until this is green."
        red "Fix it, or (emergency only): SKIP_VERIFY=1 git push ..."
        exit 1
      fi
    fi
    break
  fi
done <<< "$refs_input"

exit 0
