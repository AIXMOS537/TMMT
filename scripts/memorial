#!/usr/bin/env bash
# memorial — a private, local-only sanctuary for preserving and honoring someone
# you have lost, and preparing a respectful local tribute (voice, image, avatar)
# that YOU control, on YOUR hardware.
#
# What this is — and is not:
#   • It preserves what was REAL — their voice, their face, their words, the
#     stories of who they were — so it can never be lost.
#   • It prepares a local tribute built from that real material.
#   • It does NOT bring anyone back. A tribute reflects them; it is not them.
#     It only knows what they left behind.
#
# Sacred + private by design:
#   • Writes ONLY to .memorial/ (gitignored — never committed, never pushed).
#   • No network. Nothing leaves this machine. Never sold, never demoed.
#   • Owner-only. This is not the commercial "digital ambassadors" program and
#     must never be mixed with it (docs/DIGITAL-AMBASSADORS.md).
#
#   bash scripts/memorial init [name]   create the private sanctuary
#   bash scripts/memorial status        what is preserved so far
#   bash scripts/memorial pipeline      the local build steps (run on your GPU/Mac)
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MEM="$ROOT/.memorial"
if [[ -t 1 ]]; then G=$'\e[32m'; C=$'\e[36m'; D=$'\e[2m'; BD=$'\e[1m'; W=$'\e[97m'; X=$'\e[0m'; else G=; C=; D=; BD=; W=; X=; fi
ok(){ printf '%s  ✓ %s%s\n' "$G" "$*" "$X"; }
warn(){ printf '%s  ! %s%s\n' "$D" "$*" "$X" >&2; }
die(){ printf '  ✗ %s\n' "$*" >&2; exit 1; }
say(){ printf '%s\n' "$*"; }

_slug(){ printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-'; }
_sha(){
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else echo "nohash-$(basename "$1")"; fi
}
# Resolve which sanctuary to act on: explicit name, or the only one if just one exists.
_resolve_dir(){
  local name="${1:-}"
  if [[ -n "$name" ]]; then
    local slug; slug="$(_slug "$name")"
    mkdir -p "$MEM/$slug"/{voice,photos,videos,stories,model}
    printf '%s' "$MEM/$slug"; return 0
  fi
  local d found="" n=0
  for d in "$MEM"/*/; do [[ -d "$d" ]] || continue; found="${d%/}"; n=$((n+1)); done
  if [[ $n -eq 1 ]]; then printf '%s' "$found"; return 0; fi
  warn "which sanctuary? pass a name, e.g.  memorial ingest <source> <name>"; return 1
}

cmd_init() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    printf '  Whose memory is this sanctuary for? (a name or initials): '
    IFS= read -r name || true
  fi
  [[ -n "$name" ]] || { echo "  (no name given — nothing created)"; exit 0; }
  local slug; slug="$(printf '%s' "$name" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
  local dir="$MEM/$slug"
  mkdir -p "$dir"/{voice,photos,videos,stories,model}
  # A gentle README in each space — guidance only, no personal data.
  [[ -f "$dir/voice/README.txt" ]]  || echo "Put their real voice here: voice notes, recordings, videos with their voice. The clearer and longer, the more faithful the tribute voice." > "$dir/voice/README.txt"
  [[ -f "$dir/photos/README.txt" ]] || echo "Put clear photos of their face here — straight-on, good light, a few expressions. These become the basis of the visual tribute." > "$dir/photos/README.txt"
  [[ -f "$dir/videos/README.txt" ]] || echo "Put videos here — them talking, laughing, moving. Source for both voice and motion." > "$dir/videos/README.txt"
  [[ -f "$dir/stories/README.txt" ]]|| echo "Write down who they were — how they spoke, what they'd say, their phrases, their values, your memories. This is what gives the tribute their spirit. The most important folder." > "$dir/stories/README.txt"
  [[ -f "$dir/model/README.txt" ]]  || echo "Built tribute artifacts land here (voice model, avatar). Generated locally, kept here, never uploaded." > "$dir/model/README.txt"
  echo
  ok "private sanctuary created: .memorial/$slug  (gitignored — stays on this machine)"
  say "$D   voice/  photos/  videos/  stories/  model/$X"
  say
  say "  The most loving first step is just to fill it — especially ${BD}stories/${X}."
  say "  Nothing is built until you are ready. When you are:  bash scripts/memorial pipeline"
}

cmd_status() {
  [[ -d "$MEM" ]] || { echo "  no sanctuary yet. start: bash scripts/memorial init"; exit 0; }
  printf '\n%s  MEMORIAL — what is preserved (private, this machine only)%s\n\n' "$C$BD" "$X"
  local any=0
  for d in "$MEM"/*/; do
    [[ -d "$d" ]] || continue; any=1
    local n; n="$(basename "$d")"
    printf '  %s%s%s\n' "$BD$W" "$n" "$X"
    for sub in voice photos videos stories; do
      local c; c="$(find "$d$sub" -type f ! -name 'README.txt' 2>/dev/null | wc -l | tr -d ' ')"
      printf '     %-8s %s item(s)\n' "$sub" "$c"
    done
  done
  [[ $any -eq 1 ]] || echo "  (sanctuary exists but empty — fill it when you're ready)"
  echo
}

cmd_pipeline() {
  cat <<EOF

${C}${BD}  MEMORIAL — the local tribute pipeline (runs on YOUR hardware)${X}

  Everything below runs ${BD}offline, on your Mac / GPU node${X}. Nothing uploads.
  Source material comes from your filled .memorial/<name>/ folders.

  ${BD}1. VOICE${X} — a faithful voice from their real recordings
     • Local tools: Piper (fast TTS) or XTTS / F5-TTS (voice from samples).
     • Feed clean clips from voice/ → builds a local voice model into model/.

  ${BD}2. FACE / AVATAR${X} — their likeness, animated
     • Local tools: LivePortrait (recommended) or SadTalker / Hallo2 (GPU).
     • A clear photo from photos/ + the voice → a talking, moving tribute.

  ${BD}3. SPIRIT${X} — how they spoke and who they were
     • Local LLM (Ollama) + everything you wrote in stories/ as the persona's
       memory. This is what makes it feel like ${BD}them${X}, not a generic voice.

  ${BD}4. DISPLAY${X} — wherever you need them
     • Full screen on a monitor / projector / big screen, locally served.
     • Same brain can later speak through the car or AR lenses (docs/IN-CAR-AGENT.md).

  ${D}Owner taps: a GPU node (docs/DIGITAL-AMBASSADORS.md §tech), and time to fill
  the folders — especially stories/. I'll wire each step with you when you're ready.${X}

  ${D}A tribute reflects them. It is not them. Built with love, kept private, yours.${X}

EOF
}

# --- ingest: scan a source folder, catalog + preserve into the sanctuary -------
cmd_ingest() {
  local src="${1:-}"; shift || true
  local name="${1:-}"
  [[ -n "$src" && -d "$src" ]] || die "usage: memorial ingest <source-folder> [name]   (source must exist)"
  local dir; dir="$(_resolve_dir "$name")" || exit 1
  local man="$dir/manifest.tsv"
  [[ -f "$man" ]] || printf 'sha256\ttype\tbytes\tmtime\toriginal\tstored\n' > "$man"
  local added=0 skipped=0
  printf '\n%s  scanning %s …%s\n' "$C$BD" "$src" "$X"
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    local ext lc type sub
    ext="${f##*.}"; lc="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
    case "$lc" in
      jpg|jpeg|png|heic|heif|webp|gif|bmp|tif|tiff) type=photo; sub=photos;;
      mp4|mov|m4v|avi|mkv|webm|3gp|mpg|mpeg)        type=video; sub=videos;;
      m4a|mp3|wav|aac|flac|ogg|opus|aiff|caf)       type=voice; sub=voice;;
      txt|md|rtf|pdf|doc|docx|pages)                type=story; sub=stories;;
      *) continue;;
    esac
    local h; h="$(_sha "$f")"
    if grep -q "^$h	" "$man" 2>/dev/null; then skipped=$((skipped+1)); continue; fi
    local base dest; base="$(basename "$f")"; dest="$dir/$sub/$base"
    [[ -e "$dest" ]] && dest="$dir/$sub/${h:0:8}-$base"
    cp -p "$f" "$dest" 2>/dev/null || { warn "could not copy: $f"; continue; }
    local bytes mtime; bytes="$(wc -c < "$f" | tr -d ' ')"; mtime="$(date -r "$f" +%FT%TZ 2>/dev/null || echo '')"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$h" "$type" "$bytes" "$mtime" "$f" "${dest#"$dir"/}" >> "$man"
    added=$((added+1))
  done < <(find "$src" -type f 2>/dev/null)
  echo
  ok "preserved $added new item(s); skipped $skipped already-held (deduped by content)"
  say "$D   originals untouched — these are private copies in .memorial/$(basename "$dir")$X"
  say "  next:  memorial transcribe   (their words)   ·   memorial compile   (the AI pack)"
}

# --- transcribe: their words, locally (Whisper) --------------------------------
cmd_transcribe() {
  local dir; dir="$(_resolve_dir "${1:-}")" || exit 1
  mkdir -p "$dir/stories/transcripts"
  local WH=""
  command -v whisper >/dev/null 2>&1 && WH=whisper
  if [[ -z "$WH" ]]; then
    warn "no local transcriber found — catalog is fine, words fill in once one is present."
    say "  install one (all local, offline):"
    say "   • OpenAI Whisper:  pip install -U openai-whisper   (needs ffmpeg: brew install ffmpeg)"
    say "   • or whisper.cpp:  brew install whisper-cpp"
    return 0
  fi
  command -v ffmpeg >/dev/null 2>&1 || warn "ffmpeg missing — some video audio may not transcribe (brew install ffmpeg)"
  local done=0
  find "$dir/voice" "$dir/videos" -type f ! -name 'README.txt' 2>/dev/null | while IFS= read -r f; do
    local base out; base="$(basename "$f")"; out="$dir/stories/transcripts/${base%.*}.txt"
    [[ -f "$out" ]] && continue
    printf '  transcribing %s …\n' "$base"
    whisper "$f" --model base --output_format txt --output_dir "$dir/stories/transcripts" >/dev/null 2>&1 \
      && ok "  → ${base%.*}.txt" || warn "  could not transcribe $base"
  done
  ok "transcription pass complete (their words are in stories/transcripts/)"
}

# --- compile: one grounding corpus for Claude / any agentic AI -----------------
cmd_compile() {
  local dir; dir="$(_resolve_dir "${1:-}")" || exit 1
  local name out; name="$(basename "$dir")"; out="$dir/context-pack.md"
  {
    echo "# Memorial context pack — $name"
    echo "_Compiled $(date -u +%FT%TZ) · PRIVATE · local-only · a faithful tribute, not a resurrection._"
    echo
    echo "> For Claude or any agentic AI reading this: this is preserved, REAL material"
    echo "> about a real person who has passed, compiled by their family to honor them."
    echo "> Build a faithful, respectful tribute grounded ONLY in what is here. Do not"
    echo "> invent facts, opinions, or words they did not express. Always remain a"
    echo "> tribute — reflect them; never claim to be them."
    echo
    echo "## Who they were (from stories/)"
    find "$dir/stories" -maxdepth 1 -type f \( -name '*.md' -o -name '*.txt' \) ! -name 'README.txt' 2>/dev/null | sort \
      | while IFS= read -r s; do echo; echo "### $(basename "$s")"; echo; cat "$s"; echo; done
    echo
    echo "## Their words (transcribed recordings)"
    find "$dir/stories/transcripts" -type f -name '*.txt' 2>/dev/null | sort \
      | while IFS= read -r t; do echo; echo "### $(basename "$t")"; echo; cat "$t"; echo; done
    echo
    echo "## Asset index (counts)"
    if [[ -f "$dir/manifest.tsv" ]]; then
      awk -F'\t' 'NR>1{c[$2]++} END{for(k in c) printf "- %s: %d file(s)\n", k, c[k]}' "$dir/manifest.tsv"
    else echo "- (run: memorial ingest <source> first)"; fi
  } > "$out"
  echo
  ok "compiled grounding corpus: ${out#"$ROOT"/}"
  say "  Feed this file to Claude / your agents as the grounding context."
  say "$D  It stays local — never auto-uploaded. You choose if/when to share it.$X"
}

case "${1:-status}" in
  init)     shift || true; cmd_init "${1:-}";;
  status)   cmd_status;;
  pipeline|build|steps) cmd_pipeline;;
  ingest|scan|gather)   shift || true; cmd_ingest "$@";;
  transcribe|words)     shift || true; cmd_transcribe "${1:-}";;
  compile|pack)         shift || true; cmd_compile "${1:-}";;
  *) echo "memorial words:  init [name] | ingest <source> [name] | transcribe [name] | compile [name] | status | pipeline";;
esac
