# verify.checks — the fact-check gate's check set (read by scripts/verify-gate.sh)
# Format: name|command   (lines starting with # are ignored)
#
# This is the FAST pre-push set. CI / escalation runs the full `npm run build`.
# Add tests/integration lines as they stabilize.
types|npx tsc --noEmit
lint|npm run lint
test|npm run test
compliance|node scripts/compliance-check.mjs content/consumer-facing
secrets|bash scripts/secret-scan.sh
# build|npm run build        # uncomment for the full gate (slower)
# smoke|bash scripts/smoke-prod.sh   # integration, needs a target
