{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "swarm-coord": false
    }
  },
  "rewrites": [
    { "source": "/learn", "destination": "/learn/onboarding" },
    { "source": "/work", "destination": "/work/program" }
  ],
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/marketing-kpi-ghl", "schedule": "0 13 * * 1" },
    { "path": "/api/cron/journey-recompute", "schedule": "0 4 * * *" }
  ]
}
