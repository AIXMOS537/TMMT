# ProjectAixmos — LEGACY edition (car rentals). Managed-cloud only. NO backend brain.
# Copy to .env and fill with THEIR own keys. Never commit a real .env.
# Deploy guide: docs/LEGACY-DEPLOY-MOE.md

# Edition marker — keeps brain-dependent (AI) features in upgrade-prompt mode.
NEXT_PUBLIC_AIXMOS_EDITION=legacy

# ── Supabase (their project) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── GoHighLevel (their sub-account: CRM, payments, automations) ─────────────
GHL_WEBHOOK_SECRET=
MISSION_WEBHOOK_SECRET=
CRON_SECRET=

# ── AI backend "brain" — DISABLED in Legacy (not purchased) ────────────────
# Leave BLANK. AI/agent features stay in "Upgrade to enable" mode until licensed.
# When they buy the backend, set these (points at the metered/hosted brain):
AIXMOS_BRAIN_URL=
AIXMOS_LICENSE_KEY=

# ── Optional monitoring (inactive while empty) ─────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
