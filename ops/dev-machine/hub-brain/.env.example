# Copy to hub-brain/.env on the Windows home PC (never commit .env)

GENERIC_TIMEZONE=America/Chicago
# 3080 avoids conflict with CHUMMO serve.js on :3000
OPEN_WEBUI_PORT=3080
N8N_PORT=5678

# After Tailscale: use your hub hostname so GHL/n8n webhooks reach this box
# N8N_WEBHOOK_URL=http://home-pc:5678/
