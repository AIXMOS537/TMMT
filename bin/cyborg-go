#!/usr/bin/env bash
#
# cyborg-go — ONE SHOT to make the home M1 "be you, forever."
# Runs the whole bring-up: deps + Claude Code + MCP, local AI (Ollama + models),
# HAILMARY always-on owner-proxy (launchd), and the cron loop (executor,
# morning-brief, quo-poll, ingest-clickup). Idempotent — safe to re-run.
#
# Usage (run once on the home M1, from the repo root):
#   bash bin/cyborg-go \
#     --brain-url https://<m1>.<tailnet>.ts.net/api/memory \
#     --token <MEMORY_API_TOKEN> \
#     --cron-secret <CRON_SECRET> \
#     [--app-url http://localhost:3000]
#
# Anything already set in ~/.hailmary/config.env is reused if a flag is omitted.
set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
BRAIN_URL=""; TOKEN=""; CRON_SECRET=""; APP_URL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --brain-url) BRAIN_URL="${2:-}"; shift 2;;
    --token) TOKEN="${2:-}"; shift 2;;
    --cron-secret) CRON_SECRET="${2:-}"; shift 2;;
    --app-url) APP_URL="${2:-}"; shift 2;;
    *) echo "unknown arg: $1" >&2; shift;;
  esac
done

[ "$(uname)" = "Darwin" ] || { echo "Run this on the home M1 (macOS)."; exit 1; }
say(){ printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
warn(){ printf '\033[1;33m! %s\033[0m\n' "$*"; }

# reuse existing config if flags omitted
CFG="$HOME/.hailmary/config.env"; [ -f "$CFG" ] && . "$CFG" || true
BRAIN_URL="${BRAIN_URL:-${MEMORY_API_URL:-}}"
TOKEN="${TOKEN:-${MEMORY_API_TOKEN:-}}"
CRON_SECRET="${CRON_SECRET:-${CRON_SECRET_SAVED:-}}"
APP_URL="${APP_URL:-${HAILMARY_APP_URL:-http://localhost:3000}}"
[ -n "$BRAIN_URL" ] || { echo "Need --brain-url (or MEMORY_API_URL in $CFG)"; exit 1; }
[ -n "$TOKEN" ] || { echo "Need --token (or MEMORY_API_TOKEN in $CFG)"; exit 1; }

# ── 1. HAILMARY home node: deps + Claude + MCP + config + always-on LaunchAgent ──
say "1/4  HAILMARY home setup (deps, MCP, owner-proxy always-on)…"
bash "$REPO/scripts/hailmary-setup.sh" --role home --brain-url "$BRAIN_URL" --token "$TOKEN" \
  || warn "hailmary-setup hit an issue — review output above"

# persist cron values for re-runs
{ echo "CRON_SECRET_SAVED=\"$CRON_SECRET\""; echo "HAILMARY_APP_URL=\"$APP_URL\""; } >> "$CFG"

# ── 2. Local AI (free, no token dependence) ──
say "2/4  Local AI (Ollama + models)…"
command -v ollama >/dev/null 2>&1 || curl -fsSL https://ollama.com/install.sh | sh || warn "install Ollama manually"
(ollama serve >/dev/null 2>&1 &) ; sleep 2
for m in qwen2.5:14b nomic-embed-text llama3.2-vision; do
  say "    pulling $m"; ollama pull "$m" || warn "pull $m failed (retry later)"
done

# ── 3. Cron loop (gated, safe) ──
say "3/4  Scheduling the autonomous loop…"
if [ -n "$CRON_SECRET" ]; then
  CUR="$(crontab -l 2>/dev/null || true)"
  add(){ echo "$CUR" | grep -qF "$2" || CUR="$CUR
$1 curl -fsS -H \"x-cron-secret: $CRON_SECRET\" $APP_URL$2 >/dev/null 2>&1"; }
  add "*/15 * * * *" "/api/cron/executor"
  add "*/5 * * * *"  "/api/cron/quo-poll"
  add "0 * * * *"    "/api/cron/ingest-clickup"
  add "0 12 * * *"   "/api/cron/morning-brief"
  printf '%s\n' "$CUR" | crontab -
  say "    crontab installed (executor 15m · quo-poll 5m · clickup 1h · brief 8am ET)"
else
  warn "no --cron-secret given → skipped crontab. Re-run with --cron-secret to enable the loop."
fi

# ── 4. Smoke ──
say "4/4  Smoke test…"
command -v hailmary >/dev/null 2>&1 && hailmary status || warn "hailmary CLI not on PATH yet (open a new terminal)"

echo
say "CYBORG ONLINE — the M1 is HAILMARY-as-you, always-on."
echo "  Watch: tail -f ~/.hailmary/daemon.log"
echo "  Stop:  bash scripts/hailmary-autostart.sh --uninstall ; crontab -e (remove the cron lines)"
echo "  Still owner-only: keep it plugged in + never-sleep + on Tailscale; UPS recommended."
