# Supabase — get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — used by service.ts for privileged operations (admin user creation,
# external webhook intake). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional — public app host for portal links (defaults in next.config.mjs)
# NEXT_PUBLIC_APP_HOST=tmmt-c919-two.vercel.app
# NEXT_PUBLIC_PORTAL_URL=https://tmmt-c919-two.vercel.app

# Optional — for the public /api/intake webhook so Airtable / GHL / Zapier / n8n can POST
# anonymous submissions. Send as header: X-Intake-Secret
INTAKE_WEBHOOK_SECRET=change-me

# Webhooks — GHL / Airtable CRM sync (see INTEGRATIONS/GHL_WEBHOOK_SETUP.md)
GHL_WEBHOOK_SECRET=
# Form webhooks: auto-create intake + case (default on). Set false to only log ghl_form_submissions.
# GHL_FORM_AUTO_CASE=false
# Set to "false" to skip creating client portal reminders on GHL stage webhooks
# GHL_CLIENT_ALERTS=false
GHL_OVERDUE_WEBHOOK_SECRET=
SYNC_WEBHOOK_SECRET=
AIRTABLE_LEADS_TABLE=Leads

# n8n — generic automation ingress (header: X-N8N-Secret)
N8N_WEBHOOK_SECRET=

# AIXMOS agent panel — /api/agents/evaluate (header: X-Agent-Secret)
AGENT_WEBHOOK_SECRET=

# Journey recompute cron — GET/POST /api/cron/journey-recompute (Authorization: Bearer … or X-Cron-Secret)
# CRON_SECRET=
# Falls back to OPS_COMMAND_SECRET if CRON_SECRET is unset

# Ops command — Cursor / automations (Authorization: Bearer …)
# Generate: openssl rand -hex 32
# Also used by /internal/assistant when calling /api/ops/command from scripts
OPS_COMMAND_SECRET=

# Optional — map case status → GHL canonical stage on advance (minified JSON)
# GHL_CASE_STATUS_MAP_JSON={"vendor_in_progress":"active_rental","completed":"closed_won"}

# GHL stage webhooks — auto-verify CRM, assign staff, advance case (default on)
# Set to "false" to disable automatic case updates from GHL stage changes
GHL_AUTO_OPS=true
# Default internal assignee when a stage rule includes assignee_email
GHL_DEFAULT_ASSIGNEE_EMAIL=management@tmmtrentals.net
# Optional — override per-stage rules (minified JSON)
# GHL_STAGE_OPS_JSON={"payment_pending":{"assignee_email":"ops@tmmtrentals.net","case_status":"task_assignment"}}

# Optional — ClickUp/Airtable/GHL outbound
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_DEFAULT_LIST_ID=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
GHL_API_KEY=
# Rentals pipeline (webhooks, portal notify, cases) — your production sub-account
GHL_LOCATION_ID=Xcd8DZt5T4GWnBtBEC5V
# Credit / LTO / operator journey tags — TMMT Restoration (separate from Rentals)
# https://app.gohighlevel.com/v2/location/EaRPXFwPZbqCM9pynHwt/launchpad
GHL_RESTORATION_LOCATION_ID=EaRPXFwPZbqCM9pynHwt

# Cron — journey good-standing recompute: GET /api/cron/journey-recompute
# Header: Authorization: Bearer <secret> or X-Cron-Secret
CRON_SECRET=

# Optional — Command Center bridge (fleet, leads for LotOS dealer vertical)
# COMMAND_CENTER_SUPABASE_URL=
# COMMAND_CENTER_SUPABASE_SERVICE_KEY=

# LotOS pilot — force dealer nav without DB migration: ORG_VERTICAL=dealer
# ORG_VERTICAL=dealer

# Stripe — per-org subscriptions (Checkout + webhook)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_PRO=
# Minified JSON from INTEGRATIONS/GHL_PIPELINE_STAGE_MAP.example.json
GHL_PIPELINE_STAGE_MAP_JSON=

# Portal → GHL (OpenPhone SMS + GHL email). See docs/GHL_WORKFLOWS.md
# workflow = tag-only (trigger GHL automations). Add sms,email for API send (pick one approach).
# GHL_PORTAL_NOTIFY=workflow
# GHL_PORTAL_NOTIFY=sms,email
# GHL_EMAIL_FROM=you@yourdomain.com
# GHL_CONVERSATION_PROVIDER_ID=
# Contact custom field keys (create in GHL → Custom Fields → Contact):
# GHL_CF_CASE_REF_KEY=tmmt_case_ref
# GHL_CF_TRACK_URL_KEY=tmmt_track_url
# GHL_CF_PORTAL_URL_KEY=tmmt_portal_url
# GHL_CF_LOGIN_URL_KEY=tmmt_portal_login_url
# NEXT_PUBLIC_URGENT_PHONE=+1XXXXXXXXXX
